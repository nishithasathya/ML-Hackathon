# Copy to .env and edit. Both start scripts read this file. Never commit .env.
# ---------- Laptop 1 (API) ----------
# Folder with the 10 evaluator trips: <root>/<trip_id>/<trip_id>.{track,nodes,arcs,route}
PATHSNAP_EVAL_DATA_ROOT=/path/to/evaluator_test
PATHSNAP_DATASET_LABEL=evaluator_test
# Rehearsal with development data instead (clearly labelled in the UI):
# PATHSNAP_EVAL_DATA_ROOT=data/raw/student_test
# PATHSNAP_DATASET_LABEL=student_test (rehearsal)
PATHSNAP_ARTIFACT_DIR=artifacts
PATHSNAP_API_HOST=0.0.0.0
PATHSNAP_API_PORT=8000
PATHSNAP_CORS_ORIGINS=*
# ---------- Laptop 2 (UI) ----------
# IP address of Laptop 1 on the shared Wi-Fi / hotspot
PATHSNAP_API_URL=http://192.168.1.10:8000
PATHSNAP_UI_PORT=8501
